<% if (image_url = entry.embeddable_image_url) %>
  <%= image_tag image_url, alt: "", loading: lazy ? "lazy" : nil, referrerpolicy: "no-referrer" %>
<% elsif allow_embed && (embed_url = entry.youtube_embed_url) %>
  <%= tag.iframe src: embed_url, title: entry.title, loading: lazy ? "lazy" : nil, allowfullscreen: true %>
<% elsif linked_fallback %>
  <%= external_link_to entry.url, entry.url %>
<% else %>
  <span><%= entry.media_kind %></span>
<% end %>
