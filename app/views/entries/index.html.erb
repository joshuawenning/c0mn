<% content_for :title, "c0mn" %>
<% content_for :body_class, "collection-page" %>

<%= link_to "Skip to entries", "#collection-entries", class: "skip-link" %>

<main class="collection">
  <header class="archive-header">
    <div class="archive-header__masthead">
      <h1 class="archive-header__title">
        <%= link_to "c0mn", root_path %>
      </h1>
      <%= form_with url: root_path, method: :get, class: "archive-search" do |form| %>
        <%= hidden_field_tag :tag, @active_tag if @active_tag.present? %>
        <%= form.label :q, "Search", class: "archive-search__label" %>
        <div class="archive-search__control">
          <%= form.search_field :q, value: @query, placeholder: "Title, note, source, tag...", autocomplete: "off", maxlength: EntriesController::MAX_QUERY_LENGTH, class: "archive-search__input" %>
          <%= form.submit "Go", class: "archive-search__submit" %>
        </div>
      <% end %>
      <%= render "shared/site_navigation", active: :collection %>
    </div>

    <nav class="tag-nav" aria-label="Collection tags">
      <%= link_to root_path(q: @query.presence), class: class_names("tag-nav__item", "tag-nav__item--active": @active_tag.blank?), aria: { current: @active_tag.blank? ? "page" : nil } do %>
        <span>All</span>
        <span class="tag-nav__count"><%= @total_entry_count %></span>
      <% end %>

      <% @tags.each do |tag_record| %>
        <%= link_to root_path(tag: tag_record.slug, q: @query.presence), class: class_names("tag-nav__item", "tag-nav__item--active": @active_tag == tag_record.slug), aria: { current: @active_tag == tag_record.slug ? "page" : nil } do %>
          <%= tag_color_dot(tag_record) %>
          <span><%= tag_record.name %></span>
          <span class="tag-nav__count"><%= tag_record.taggings_count %></span>
        <% end %>
      <% end %>
    </nav>
  </header>

  <% if @entries.any? %>
    <% excerpts = entry_notes_excerpts(@entries) %>
    <section id="collection-entries" class="entry-grid" aria-label="Collected entries" tabindex="-1">
      <% @entries.each do |entry| %>
        <article class="entry-card entry-card--<%= entry.media_kind %>">
          <%= link_to entry_path(entry), class: "entry-card__media", aria: { label: entry.title } do %>
            <%= render "preview", entry: entry, lazy: true, linked_fallback: false, allow_embed: false %>
          <% end %>

          <div class="entry-card__body">
            <div class="entry-card__meta">
              <span class="entry-card__source"><%= entry.source_name %></span>
              <time datetime="<%= entry.collected_at.to_date.iso8601 %>"><%= entry.collected_at.to_date.to_fs(:short) %></time>
            </div>
            <h2 class="entry-card__title"><%= link_to entry.title, entry_path(entry) %></h2>
            <% if entry.notes.present? %>
              <p class="entry-card__excerpt"><%= excerpts.fetch(entry.id) %></p>
            <% end %>

            <% if entry.tags.any? %>
              <nav class="entry-card__tags" aria-label="Tags for <%= entry.title %>">
                <% entry.tags.each do |tag_record| %>
                  <%= link_to root_path(tag: tag_record.slug), class: "entry-card__tag" do %>
                    <%= tag_color_dot(tag_record) %>
                    <span><%= tag_record.name %></span>
                  <% end %>
                <% end %>
              </nav>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>

    <%= render "shared/pagination", page: @page, total_pages: @total_pages, label: "Collection pages",
      previous_path: root_path(q: @query.presence, tag: @active_tag.presence, page: @page - 1),
      next_path: root_path(q: @query.presence, tag: @active_tag.presence, page: @page + 1) %>
  <% else %>
    <section id="collection-entries" class="empty-state empty-state--collection" tabindex="-1">
      <p>No entries found.</p>
      <% if authenticated? && Current.user.platform_admin? %>
        <%= link_to @total_entry_count.zero? ? "Add the first one" : "Add an entry", new_admin_entry_path, class: "button" %>
      <% end %>
    </section>
  <% end %>

  <%= render "shared/site_footer" %>
</main>
