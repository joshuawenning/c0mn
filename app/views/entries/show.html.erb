<% content_for :title, "#{@entry.title} | c0mn" %>
<% content_for :body_class, "entry-page" %>

<main class="shell shell--detail">
  <%= render "shared/site_header", active: :collection, navigation: true %>

  <article class="entry-detail">
    <aside class="entry-detail__meta" aria-label="Entry details">
      <p class="entry-detail__source"><%= @entry.source_name %></p>
      <p class="entry-detail__kind"><%= @entry.media_kind %></p>
      <time class="entry-detail__date" datetime="<%= @entry.collected_at.to_date.iso8601 %>"><%= @entry.collected_at.to_date.to_fs(:long) %></time>
      <% if @entry.tags.any? %>
        <nav class="entry-detail__tags" aria-label="Entry tags">
          <% @entry.tags.each do |tag_record| %>
            <%= link_to root_path(tag: tag_record.slug), class: "entry-detail__tag" do %>
              <%= tag_color_dot(tag_record) %>
              <span><%= tag_record.name %></span>
            <% end %>
          <% end %>
        </nav>
      <% end %>
    </aside>

    <div class="entry-detail__main">
      <h1 class="entry-detail__title"><%= @entry.title %></h1>

      <div class="entry-detail__media">
        <%= render "preview", entry: @entry, lazy: false, linked_fallback: true, allow_embed: true %>
      </div>

      <% if @entry.notes.present? %>
        <div class="markdown notes entry-detail__notes"><%= render_markdown(@entry.notes) %></div>
      <% end %>

      <%= external_link_to @entry.url, @entry.url, class_name: "entry-detail__url" %>
    </div>
  </article>
</main>
