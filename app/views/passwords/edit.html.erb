<% content_for :title, "Choose a new password | c0mn" %>
<% content_for :body_class, "authentication-page" %>

<main class="shell shell--authentication">
  <%= render "shared/site_header", active: nil, navigation: false %>

  <section class="authentication-panel">
    <p class="authentication-panel__eyebrow">Administrator access</p>
    <h1>New password</h1>

    <% if @user.errors.any? %>
      <div id="password-reset-errors" class="entry-form__errors" role="alert">
        <p><%= pluralize(@user.errors.count, "error") %> prevented the password from being reset.</p>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "authentication-form" do |form| %>
      <div class="form-field authentication-form__field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password", class: "form-control form-control--single-line", aria: { invalid: @user.errors.include?(:password), describedby: @user.errors.any? ? "password-reset-errors" : nil } %>
      </div>

      <div class="form-field authentication-form__field">
        <%= form.label :password_confirmation, "Confirm password" %>
        <%= form.password_field :password_confirmation, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password", class: "form-control form-control--single-line", aria: { invalid: @user.errors.include?(:password_confirmation), describedby: @user.errors.any? ? "password-reset-errors" : nil } %>
      </div>

      <%= form.submit "Save password", class: "button button--primary" %>
    <% end %>
  </section>
</main>
