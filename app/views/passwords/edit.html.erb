<% content_for :title, "Choose a new password | c0mn" %>
<% content_for :body_class, "authentication-page" %>

<main class="shell shell--authentication">
  <header class="site-header">
    <%= link_to "c0mn", root_path, class: "site-header__wordmark" %>
  </header>

  <section class="authentication-panel">
    <p class="authentication-panel__eyebrow">Owner access</p>
    <h1>New password</h1>

    <%= form_with url: password_path(params[:token]), method: :put, class: "authentication-form" do |form| %>
      <div class="form-field authentication-form__field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "form-control form-control--single-line" %>
      </div>

      <div class="form-field authentication-form__field">
        <%= form.label :password_confirmation, "Confirm password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-control form-control--single-line" %>
      </div>

      <%= form.submit "Save password", class: "button button--primary" %>
    <% end %>
  </section>
</main>
