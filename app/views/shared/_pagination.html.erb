<% if total_pages > 1 %>
  <nav class="pagination" aria-label="<%= label %>">
    <%= link_to "Previous", previous_path, class: "button" if page > 1 %>
    <span class="pagination__status">Page <%= page %> of <%= total_pages %></span>
    <%= link_to "Next", next_path, class: "button" if page < total_pages %>
  </nav>
<% end %>
